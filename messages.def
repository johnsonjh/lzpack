# LZPACK message catalog - processed by strpack into csmsg.h
# NAME<TAB>GUARD<TAB>TEXT  (guard '-' = unconditional; C escapes in TEXT)
# A '~' prefix on the guard excludes the string from book training (use it
# for strings absent from the CP/M-80 binaries, so their catalogs cannot
# shift); the prefix is not part of the emitted guard.
MSG_E_READ	-	ERROR: cannot read %s\n
MSG_E_WRITE	-	ERROR: cannot write %s\n
MSG_E_OARG	-	ERROR: -O requires an argument\n
MSG_E_UNKNOWN	-	ERROR: unknown option %s\n
MSG_E_OMULTI	-	ERROR: -O cannot be used with multiple files\n
MSG_P_LNOTPOP	-	  %-16s (not an LZPACK file)\n
MSG_P_LSIZES	defined(LZPACK_COMPRESS_ONLY)	  %-16s compressed %6ld   original %6ld   (%ld.%ld%%)\n
MSG_P_LSIZES	!defined(LZPACK_COMPRESS_ONLY)	  %-16s compressed %6ld   original %6ld   (%ld.%ld%%)%s\n
MSG_P_LFLOOR0	!defined(LZPACK_COMPRESS_ONLY)	  %-16s -C check; floor 0x%04X\n
MSG_P_LNOCHK	!defined(LZPACK_COMPRESS_ONLY)	  %-16s no -C check\n
MSG_V_HERALD1	-	%s %s - CP/M-80 (8080 and Z80) executable %s\n
MSG_V_COPYR	-	Copyright (c) 2026 Jeffrey H. Johnson <johnsonjh.dev@gmail.com>\n
MSG_V_HOME	-	The LZPACK canonical homepage is https://github.com/johnsonjh/lzpack\nThis program is distributed under the terms of the MIT-0 license.\n
MSG_U_HDR	-	\nUsage:\n
MSG_NONE	-	
MSG_E_PACKED	defined(LZPACK_STREAM) && !defined(LZPACK_DECODE_ONLY)	ERROR: %s is already packed; restore it first\n
MSG_E_MZX	!defined(LZPACK_DECODE_ONLY)	ERROR: %s exceeds %ld max file size\n
MSG_E_HDRBIG	!defined(LZPACK_DECODE_ONLY)	ERROR: %s is too large for CP/M (max 65535 bytes)\n
MSG_E_SMALL	!defined(LZPACK_DECODE_ONLY)	ERROR: %s too small\n
MSG_E_NOFIT	!defined(LZPACK_DECODE_ONLY)	ERROR: %s unable to fit in ~%ldK (%ld bytes) memory; try -M %ld\n
MSG_E_GENCOM	!defined(LZPACK_DECODE_ONLY)	ERROR: %s GENCOM unsupported\n
MSG_P_WINDOW	defined(LZPACK_STREAM) && !defined(LZPACK_DECODE_ONLY)	  %-12s window %ld bytes (max distance %ld)\n
MSG_P_SKIPPED	!defined(LZPACK_DECODE_ONLY)	  %-12s -- inefficient (%ld => %ld), skipped\n
MSG_P_PACKED	!defined(LZPACK_DECODE_ONLY)	  %-12s %6ld => %6ld  (%ld.%ld%%)  [%s%s]  -> %s\n
MSG_P_NOEXTRA	!defined(LZPACK_DECODE_ONLY) && defined(LZPACK_NO_OPT)	  (note: -E is not available in this build)\n
MSG_E_TMPMAKE	defined(LZPACK_STREAM) && !defined(LZPACK_DECODE_ONLY)	ERROR: cannot create temp file %s\n
MSG_E_TMPOPEN	defined(LZPACK_STREAM) && !defined(LZPACK_DECODE_ONLY)	ERROR: cannot reopen temp file %s\n
MSG_E_WINMEM	defined(LZPACK_STREAM) && !defined(LZPACK_DECODE_ONLY)	ERROR: out of memory for compression window\n
MSG_E_RESTBIG	~!defined(LZPACK_STREAM) && !defined(LZPACK_COMPRESS_ONLY)	ERROR: %s is too large to restore in this build\n
MSG_E_NOTPOP	!defined(LZPACK_COMPRESS_ONLY)	ERROR: %s is not an LZPACK file\n
MSG_E_EXPMZX	!defined(LZPACK_COMPRESS_ONLY)	ERROR: %s expands beyond max of %ld\n
MSG_E_BADHDR	!defined(LZPACK_COMPRESS_ONLY)	ERROR: %s has invalid header data\n
MSG_E_RESTOOM	defined(LZPACK_STREAM) && !defined(LZPACK_COMPRESS_ONLY)	ERROR: %s too large to restore (out of memory)\n
MSG_P_RESTORED	!defined(LZPACK_COMPRESS_ONLY)	  %-12s %6ld => %6ld  -> %s\n
MSG_P_PROG	!defined(LZPACK_DECODE_ONLY) && !defined(LZPACK_NO_PROGRESS)	\r  %-12s %-3s%3d%% 
MSG_U_PACKLN	~!defined(LZPACK_DECODE_ONLY) && !defined(LZPACK_NO_OPT)	  lzpack [-E] [-8|-Z] <file>  compress (-E: extra, -8/-Z: force 8080/Z80 stub)\n
MSG_U_PACKLN	!defined(LZPACK_DECODE_ONLY) && defined(LZPACK_NO_OPT)	  lzpack [-8|-Z] <file>       compress (-8/-Z: force 8080/Z80 stub)\n
MSG_U_RLINE	!defined(LZPACK_DECODE_ONLY) && !defined(LZPACK_COMPRESS_ONLY)	  lzpack -R <file>            restore (decompress)\n
MSG_U_LO	!defined(LZPACK_DECODE_ONLY)	  lzpack -L <file>            list stored sizes\n  lzpack -O <name>            set output name\n
MSG_U_MC	!defined(LZPACK_DECODE_ONLY)	  lzpack -M <top>             set memory top (default 48K)\n  lzpack -C                   stub verifies memory at run time\n
MSG_U_ILINE	!defined(LZPACK_DECODE_ONLY) && defined(LZ_CPM)	  lzpack -I                   use ISX LRBC convention\n
MSG_U_VLINE	!defined(LZPACK_DECODE_ONLY)	  lzpack -V                   show LZPACK information\n
MSG_U_UBARE	defined(LZPACK_DECODE_ONLY)	  lzunpack <file>             restore (decompress)\n  lzunpack -L <file>          list stored sizes\n
MSG_U_UO	defined(LZPACK_DECODE_ONLY)	  lzunpack -O <name>          set output name\n
MSG_U_UILINE	defined(LZPACK_DECODE_ONLY) && defined(LZ_CPM)	  lzunpack -I                 use ISX LRBC convention\n
MSG_U_UVLINE	defined(LZPACK_DECODE_ONLY)	  lzunpack -V                 show LZUNPACK information\n
MSG_V_CPM	defined(LZ_CPM)	%s %d.%d (BDOS %02Xh, system %02Xh)
MSG_V_LRBC1	defined(LZ_CPM)	; Last Record Byte Count supported.\n
MSG_V_LRBC0	defined(LZ_CPM)	; no Last Record Byte Count support.\n
MSG_V_BUILDD	defined(LZPACK_DECODE_ONLY) && defined(LZ_CPM)	%s build; %uK %s free.\n
MSG_V_BUILDC	!defined(LZPACK_DECODE_ONLY) && defined(LZ_CPM)	%s build; extra compression (-E) %s; %uK %s free.\n
MSG_V_AUTO1	!defined(LZPACK_DECODE_ONLY) && defined(LZ_CPM) && !defined(LZPACK_NO_AUTOARCH)	Stub autodetect on; -8/-Z override.\n
MSG_V_AUTO0	!defined(LZPACK_DECODE_ONLY) && defined(LZ_CPM) && defined(LZPACK_NO_AUTOARCH)	Stub autodetect off: defaults to %s, -8/-Z override.\n
MSG_E_BADM	!defined(LZPACK_DECODE_ONLY)	ERROR: bad -m value\n
MSG_E_IREQ	defined(LZ_CPM)	ERROR: -I requires CP/M with LRBC support\n
MSG_E_NOREST	defined(LZPACK_COMPRESS_ONLY)	ERROR: this build cannot restore\n
MSG_U_FLINE	~!defined(LZPACK_DECODE_ONLY) && !defined(LZPACK_COMPRESS_ONLY)	  lzpack -F <floor>           require memory top >= floor (implies -C)\n
MSG_E_BADF	~!defined(LZPACK_DECODE_ONLY) && !defined(LZPACK_COMPRESS_ONLY)	ERROR: bad -f value\n
MSG_E_OOM	~!defined(LZPACK_DECODE_ONLY) && !defined(LZPACK_STREAM)	ERROR: out of memory!\n
MSG_E_EOD	~!defined(LZPACK_COMPRESS_ONLY) && !defined(LZ_ASM_RESTORE) && !defined(LZ_ASM_RESTORE_86)	ERROR: unexpected end of data\n
MSG_E_UNDERFLOW	~!defined(LZPACK_COMPRESS_ONLY) && !defined(LZ_ASM_RESTORE) && !defined(LZ_ASM_RESTORE_86)	ERROR: invalid compressed data (underflow)\n
MSG_P_REPACK	~!defined(LZPACK_DECODE_ONLY) && !defined(LZPACK_COMPRESS_ONLY) && !defined(LZPACK_STREAM)	  %-12s already packed; recompressing original\n
